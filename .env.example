# League configuration. Copy to .env.local and adjust.
# None of these are secret except MFL_APIKEY.

MFL_LEAGUE_ID=63396
MFL_FRANCHISE_ID=0012

# Season to read. 2025 is a completed season and therefore has real pre/live/
# final data; the 2026 season has not kicked off, so every score reads zero.
MFL_SEASON=2025

# Simulated "now". The app treats this instant as the present and shows nothing
# that had not happened by then, so a finished season can be replayed through
# its real states. Unset to use wall-clock time.
#   2025-11-13T18:00:00Z  → Week 11 upcoming, nothing kicked off
#   2025-11-16T21:00:00Z  → Week 11 live, early games final, late slate pending
#   2025-11-18T12:00:00Z  → Week 11 complete
MFL_SIM_NOW=2025-11-16T21:00:00Z

# Optional per-user API key (Help -> Developer's API on the league site).
# Nothing in v1 needs it; it is attached to every request when present.
MFL_APIKEY=

# Optional: skip host discovery by pinning the league's assigned server.
# Discovery goes through api.myfantasyleague.com, which is rate limited more
# tightly than the league host. Resolve once, then pin it here.
MFL_HOST=https://www44.myfantasyleague.com

# Minimum gap between MFL requests, in ms. Raise if you see 429s.
MFL_REQUEST_GAP_MS=900
